# Copy to .env.local and fill in. Never commit .env.local.

# Supabase dashboard > your project > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Bypasses Row Level Security, so never add NEXT_PUBLIC_ to this name.
SUPABASE_SECRET_KEY=sb_secret_...

# Server only. Anthropic Console > API Keys. Never add NEXT_PUBLIC_ to this name.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

# Phase 4 terminal agent (npm run agent): a test user made through /signup.
AGENT_TEST_EMAIL=
AGENT_TEST_PASSWORD=
